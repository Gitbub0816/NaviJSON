# NaviJSON environment. Copy to .env.local and fill in.
# NEXT_PUBLIC_* vars are inlined at BUILD time — set them before `npm run build`.

# Mapbox public token — enables Mapbox GL rendering + the 3D POV drive.
# Without it, the map falls back to the keyless 2D canvas (no navigation).
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=pk.your_public_token

# Public site URL — used for favicon/OG absolute URLs. Set to your deployed
# origin, or favicons resolve to http://localhost:3000 and break in production.
NEXT_PUBLIC_SITE_URL=https://navijson.your-subdomain.workers.dev

# --- Data source (optional) ---
# By default the map serves same-origin, deploy-sized data files generated at
# build time (features-render.geojson + roads.geojson, both < 25 MiB). You only
# need these if you host the full data on a CORS-enabled origin (a custom domain
# on R2/S3 — NOT an r2.dev URL, which ignores bucket CORS).
# NEXT_PUBLIC_FEATURES_URL=https://cdn.your-domain.com/features.geojson
# NEXT_PUBLIC_ROUTING_URL=https://cdn.your-domain.com/roads.geojson

# Optional: statewide vector tileset.
#   mapbox://YOURNAME.california   (Mapbox-hosted)
#   pmtiles://https://pub-xxxx.r2.dev/california.pmtiles   (PMTiles on R2)
NEXT_PUBLIC_NAVIJSON_TILESET=
