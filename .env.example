# NaviJSON environment. Copy to .env.local and fill in.
# NEXT_PUBLIC_* vars are inlined at BUILD time — set them before `npm run build`.

# Mapbox public token — enables Mapbox GL rendering + the 3D POV drive.
# Without it, the map falls back to the keyless 2D canvas (no navigation).
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=pk.your_public_token

# Public URL of features.geojson served from object storage (R2/S3).
# REQUIRED in production: the ~48 MB file is not bundled as a Cloudflare asset.
# Example (R2 dev URL): https://pub-xxxxxxxx.r2.dev/features.geojson
NEXT_PUBLIC_FEATURES_URL=

# Optional: statewide vector tileset.
#   mapbox://YOURNAME.california   (Mapbox-hosted)
#   pmtiles://https://pub-xxxx.r2.dev/california.pmtiles   (PMTiles on R2)
NEXT_PUBLIC_NAVIJSON_TILESET=
